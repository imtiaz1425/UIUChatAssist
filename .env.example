# ========================================================
# UIU ChatAssist - Environment Variables Template
# ========================================================
# Copy this file to '.env' and fill in your actual values:
#   copy .env.example .env
#
# IMPORTANT: Never commit your actual '.env' file to Git!
# ========================================================

# Groq Cloud API Key
# Sign up and generate an API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Flask Application Secret Key
# Used to cryptographically sign session cookies.
# Generate a secure random string in Python:
#   python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=your_flask_secret_key_here

